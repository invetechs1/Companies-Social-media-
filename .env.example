# ==========================================================
# Bassir Social Pro - Environment Configuration
# Copy this file to .env and fill in your values.
# ==========================================================

# Database (SQLite by default; use a postgresql:// URL in production)
DATABASE_URL="file:./dev.db"

# App
APP_URL="http://localhost:3000"
# Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-secret"

# Secret token required to call /api/cron/publish (scheduler endpoint)
CRON_SECRET="change-me-cron-secret"

# ----------------------------------------------------------
# Social platform OAuth apps.
# Create a developer app on each platform and paste keys here.
# Redirect URI for every platform: {APP_URL}/api/oauth/{provider}/callback
# e.g. http://localhost:3000/api/oauth/facebook/callback
# ----------------------------------------------------------

# Meta (Facebook Pages + Instagram Business) - https://developers.facebook.com
META_APP_ID=""
META_APP_SECRET=""

# X / Twitter (OAuth 2.0 with PKCE) - https://developer.x.com
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# LinkedIn - https://developer.linkedin.com
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# TikTok - https://developers.tiktok.com
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# YouTube (Google Cloud Console) - https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----------------------------------------------------------
# Billing (Stripe) - https://dashboard.stripe.com
# Create three recurring Prices (Starter/Pro/Enterprise) and
# a webhook to {APP_URL}/api/billing/webhook with events:
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed
# ----------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# ----------------------------------------------------------
# AI writing assistant (optional) — Anthropic Claude API
# Get a key at https://console.anthropic.com. When unset, the AI
# buttons in the composer return a "not configured" message.
# ----------------------------------------------------------
ANTHROPIC_API_KEY=""
# Optional: override the model (defaults to claude-opus-5-5).
# Use a cheaper model like claude-haiku-5-5 to reduce cost.
AI_MODEL=""

# ----------------------------------------------------------
# Email (optional) — scheduled client performance reports (SMTP)
# When unset, report emails are disabled (the report page still works
# and clients can Save-as-PDF). Works with any SMTP provider.
# ----------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Bassir Social Pro <reports@yourdomain.com>"
